{
  "name": "localshare",
  "version": "1.2.84",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "desktop": "node scripts/run_desktop.js",
    "desktop:build": "node ./scripts/build_desktop.js",
    "pc": "node scripts/run_desktop.js",
    "pc:server": "node desktop/engine/desktop-node.js",
    "e2e": "detox test --configuration android.emu.debug",
    "pc:firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow_firewall.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "expo": "~51.0.38",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-status-bar": "~1.12.1",
    "nodejs-mobile-react-native": "^18.17.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-ble-plx": "^3.2.1",
    "react-native-document-picker": "^9.3.0",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^4.1.5",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.3.0",
    "react-native-vision-camera": "^4.5.3",
    "react-native-zeroconf": "^0.13.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@types/react": "~18.2.79",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~11.0.14",
    "electron": "^30.0.0",
    "electron-packager": "^17.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "typescript": "^5.3.3"
  }
